# ---------------------------------------------------------------------------
# Compass MCP server configuration (ALL OPTIONAL)
#
# Credentials are NOT set here. They are read from your .ionapi files, which the
# server auto-discovers (it looks for credentials.ionapi and credentials_trn.ionapi
# next to server.py). These variables only override defaults if you need to.
# ---------------------------------------------------------------------------

# ---- Production environment ----

# Path to your production .ionapi credentials file (default: credentials.ionapi next to server.py)
# IONAPI_FILE=/absolute/path/to/your.ionapi

# Override the derived Compass base URL (normally derived from the .ionapi tenant)
# COMPASS_BASE_URL=https://mingle-ionapi.inforcloudsuite.com/YOUR_TENANT_ID/DATAFABRIC/compass/v2

# ---- Training (TRN) environment ----

# Path to your training .ionapi credentials file (default: credentials_trn.ionapi next to server.py)
# IONAPI_FILE_TRN=/absolute/path/to/your_trn.ionapi

# Override the Compass base URL for training environment
# COMPASS_BASE_URL_TRN=https://mingle-ionapi.inforcloudsuite.com/YOUR_TRN_TENANT_ID/DATAFABRIC/compass/v2

# ---- Query/Export settings ----

# Default maximum rows returned per query
# COMPASS_MAX_ROWS=1000

# How long to wait for a query to finish, in seconds
# COMPASS_POLL_TIMEOUT=120

# Seconds between status checks while a query runs
# COMPASS_POLL_INTERVAL=2

# Per-request HTTP timeout, in seconds
# COMPASS_HTTP_TIMEOUT=60

# Rows per page when paginating results (default 25000, auto-scales down for wide tables)
# COMPASS_PAGE_SIZE=25000
