# ---------------------------------------------------------------------------
# Compass MCP server configuration (ALL OPTIONAL)
#
# Credentials are NOT set here. They are read from your .ionapi file, which the
# server auto-discovers (it looks for credentials.ionapi next to server.py).
# These variables only override defaults if you need to.
# ---------------------------------------------------------------------------

# Path to your .ionapi credentials file (default: credentials.ionapi next to server.py)
# IONAPI_FILE=/absolute/path/to/your.ionapi

# Override the derived Compass base URL (normally derived from the .ionapi tenant)
# COMPASS_BASE_URL=https://mingle-ionapi.inforcloudsuite.com/YOUR_TENANT_ID/DATAFABRIC/compass/v2

# Default maximum rows returned per query
# COMPASS_MAX_ROWS=1000

# How long to wait for a query to finish, in seconds
# COMPASS_POLL_TIMEOUT=120

# Seconds between status checks while a query runs
# COMPASS_POLL_INTERVAL=2

# Per-request HTTP timeout, in seconds
# COMPASS_HTTP_TIMEOUT=60
