# ---------------------------------------------------------------------------
# Compass MCP server configuration (ALL OPTIONAL)
#
# Credentials are NOT set here. They are read from your .ionapi files, which the
# server auto-discovers (it looks for credentials.ionapi and credentials_trn.ionapi
# next to server.py). These variables only override defaults if you need to.
# ---------------------------------------------------------------------------

# ---- Production environment ----

# Path to your production .ionapi credentials file (default: credentials.ionapi next to server.py)
# IONAPI_FILE=/absolute/path/to/your.ionapi

# Override the derived Compass base URL (normally derived from the .ionapi tenant)
# COMPASS_BASE_URL=https://mingle-ionapi.inforcloudsuite.com/YOUR_TENANT_ID/DATAFABRIC/compass/v2

# ---- Training (TRN) environment ----

# Path to your training .ionapi credentials file (default: credentials_trn.ionapi next to server.py)
# IONAPI_FILE_TRN=/absolute/path/to/your_trn.ionapi

# Override the Compass base URL for training environment
# COMPASS_BASE_URL_TRN=https://mingle-ionapi.inforcloudsuite.com/YOUR_TRN_TENANT_ID/DATAFABRIC/compass/v2

# ---- Query/Export settings ----

# Default maximum rows returned per query
# COMPASS_MAX_ROWS=1000

# How long to wait for a query to finish, in seconds
# COMPASS_POLL_TIMEOUT=120

# Seconds between status checks while a query runs
# COMPASS_POLL_INTERVAL=2

# Per-request HTTP timeout, in seconds
# COMPASS_HTTP_TIMEOUT=60

# Rows per page when paginating results (default 25000, auto-scales down for wide tables)
# COMPASS_PAGE_SIZE=25000

# ---- OAuth scopes (optional; normally leave unset) ----
#
# The grant type (password vs client_credentials) and scopes come from the
# .ionapi file ("gt" and "sc"). Set these only to request FEWER scopes than the
# file lists; an empty value sends no scope. Space-separated. This can never
# grant more than the Authorized App allows.
#
# Scope names in our tenant (check your app's scope list in ION API):
#   Infor-DataFabric  query_compass, export_compass_to_excel, ping
#   Infor-SX          fetch_csd, export_csd_to_excel
# COMPASS_OAUTH_SCOPE=Infor-DataFabric Infor-SX
# COMPASS_OAUTH_SCOPE_TRN=Infor-DataFabric Infor-SX

# ---------------------------------------------------------------------------
# CSD FetchWhere (the `fetch_csd` / `fetch_csd_trn` tools) — read the live CSD
# database directly, bypassing the Compass datalake replica. Same .ionapi
# credentials as the matching environment above (credentials.ionapi for
# fetch_csd, credentials_trn.ionapi for fetch_csd_trn).
# ---------------------------------------------------------------------------

# REQUIRED to use fetch_csd: your own CSD operator/login code (e.g. "AC01").
# Ask whoever administers CSD operators if you don't know yours. There is no
# default — the fetch tools return a clear error until this is set.
# fetch_csd_trn uses the same code unless you set CSD_OPERATOR_INIT_TRN.
# CSD_OPERATOR_INIT=AC01
# CSD_OPERATOR_INIT_TRN=AC01

# CSD company number (default: 1 — Team Air Distributing is single-company)
# CSD_COMPANY_NUMBER=1
# CSD_COMPANY_NUMBER_TRN=1

# Override the derived CSD FetchWhere base URL (normally derived from the .ionapi tenant)
# CSD_BASE_URL=https://mingle-ionapi.inforcloudsuite.com/YOUR_TENANT_ID/SX/rest
# CSD_BASE_URL_TRN=https://mingle-ionapi.inforcloudsuite.com/YOUR_TRN_TENANT_ID/SX/rest

# Rows fetched per FetchWhere page (default: 500). Higher is fine; CSD has no
# page-size cap like Compass's ~10MB limit.
# CSD_BATCH_SIZE=500
